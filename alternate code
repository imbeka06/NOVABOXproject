  } else {
    Serial.println("GPS Speed: Invalid");
  }
  // check accidnet condition
  if (accidentConfirmed || rolloverConfirmed) {
    // Log data to SD card
    DateTime now = rtc.now(); // Get current date and time from RTC
    timestamp = String(now.year()) + "-" + String(now.month()) + "-" + String(now.day()) + " " +
                String(now.hour()) + ":" + String(now.minute()) + ":" + String(now.second());
