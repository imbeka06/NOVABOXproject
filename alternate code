    digitalWrite(LED_PIN, LOW); // Turn off LED
    digitalWrite(BUZZER_PIN, LOW); // Turn off buzzer
  } else {
    Serial.println("No accident detected."); // Print no accident detected message
  }
  // Trigger emergency protocol if  ccident confirmed
  if (accidentConfirmed || rolloverConfirmed) {
