  // confirm accident more of multi-check
  if (accidentConfirmed) {
    Serial.println("Accident confirmed!"); // Print accident confirmed message
    digitalWrite(LED_PIN, HIGH); // Turn on LED
    digitalWrite(BUZZER_PIN, HIGH); // Turn on buzzer
